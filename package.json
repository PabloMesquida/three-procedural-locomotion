{
  "name": "three-procedural-locomotion",
  "version": "0.1.0",
  "description": "Procedural human locomotion for Three.js (gait, footstep planning, IK; no baked animations).",
  "license": "MIT",
  "author": "Pablo Mesquida",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PabloMesquida/three-procedural-locomotion.git"
  },
  "homepage": "https://github.com/PabloMesquida/three-procedural-locomotion#readme",
  "bugs": {
    "url": "https://github.com/PabloMesquida/three-procedural-locomotion/issues"
  },
  "keywords": [
    "three",
    "threejs",
    "procedural",
    "animation",
    "locomotion",
    "walk",
    "gait",
    "ik",
    "inverse-kinematics",
    "character",
    "mixamo",
    "rigify"
  ],
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./debug": {
      "types": "./dist/debug/index.d.ts",
      "import": "./dist/debug/index.js"
    },
    "./parameters.json": "./docs/parameters.json",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "docs",
    "examples",
    "README.md",
    "README.es.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "node scripts/build-lib.mjs",
    "build:watch": "tsc -p tsconfig.lib.json --watch",
    "typecheck": "tsc",
    "test": "node scripts/run-tests.mjs",
    "mocap": "node scripts/mocap.mjs",
    "bench": "node scripts/bench.mjs",
    "docs": "node scripts/gen-docs.mjs",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "three": ">=0.150.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/three": "^0.186.0",
    "three": "^0.186.1",
    "typescript": "~6.0.2"
  }
}
