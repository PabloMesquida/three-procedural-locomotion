{
  "compilerOptions": {
    "target": "es2023",
    "module": "esnext",
    "lib": ["ES2023", "DOM"],
    "types": [],
    "allowArbitraryExtensions": true,
    "skipLibCheck": true,
    "strict": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,

    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true,

    /* Los ejemplos importan el paquete por su nombre; aquí se resuelve al código fuente */
    "paths": {
      "three-procedural-locomotion": ["./src/index.ts"],
      "three-procedural-locomotion/debug": ["./src/debug/index.ts"]
    }
  },
  "include": ["src", "examples"]
}
